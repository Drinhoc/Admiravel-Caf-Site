# Copie para .env (no computador) ou cadastre no Netlify: Site configuration → Environment variables.
# Sem nenhuma variável o site roda em modo demonstração (pagamento simulado, banco em memória).

# Endereço público do site (sem barra no fim). No Netlify, antes do domínio: https://<nome>.netlify.app
SITE_URL=

# ---------- Banco e login do painel (Supabase → Project Settings → API) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# chave "service_role": NUNCA coloque no código nem mande por WhatsApp
SUPABASE_SERVICE_KEY=

# ---------- Pagamento ----------
PAGAMENTO_PROVEDOR=infinitepay
# sua InfiniteTag, sem o $ (ex.: admiravelcafe)
INFINITEPAY_HANDLE=
# opcional, só se a InfinitePay fornecer uma chave de API para a conta
INFINITEPAY_API_KEY=
# alternativa (PAGAMENTO_PROVEDOR=mercadopago)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---------- Nota fiscal (deixe NF_PROVEDOR vazio para vender com declaração de conteúdo) ----------
NF_PROVEDOR=
NOTAAS_API_KEY=
NOTAAS_WEBHOOK_SECRET=
# alternativa (NF_PROVEDOR=focus)
FOCUS_TOKEN=
FOCUS_AMBIENTE=homologacao
FOCUS_WEBHOOK_SECRET=

# ---------- Frete e etiqueta (Melhor Envio) ----------
ME_TOKEN=
# true = ambiente de teste (sandbox.melhorenvio.com.br). Troque para false quando for vender de verdade.
ME_SANDBOX=true
ME_EMAIL=admiravelcafe@gmail.com

# ---------- Avisos ----------
# e-mail (Resend): para quem vai o aviso de pedido novo, e de qual endereço saem os e-mails
RESEND_API_KEY=
AVISO_EMAIL_PARA=admiravelcafe@gmail.com
AVISO_EMAIL_DE=Admirável Café <pedidos@admiravelcafe.com.br>
# Telegram (opcional, aviso no celular na hora)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
