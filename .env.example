# Copie para .env (no computador) ou cadastre na hospedagem: Railway → Variables (ou Netlify → Environment variables).
# Sem nenhuma variável o site roda em modo demonstração (pagamento simulado, banco em memória, painel aceita qualquer senha).

# Endereço público do site (sem barra no fim). No Railway é preenchido sozinho até ter domínio; no Netlify: https://<nome>.netlify.app
SITE_URL=

# ---------- Banco (Postgres do Railway) ----------
# No Railway: crie o banco (+ New → Database → PostgreSQL) e, no serviço do site, use a referência abaixo.
# As tabelas e o catálogo inicial são criados sozinhos na primeira subida.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---------- Acesso ao painel ----------
# E-mails que entram no painel (separados por vírgula) e uma senha provisória (8+ caracteres).
# Cada um troca a sua senha no painel, em Ajustes. Mudar ADMIN_SENHA aqui redefine a senha de todos esses e-mails.
ADMIN_EMAIL=admiravelcafe@gmail.com
ADMIN_SENHA=

# ---------- Pagamento ----------
PAGAMENTO_PROVEDOR=infinitepay
# sua InfiniteTag, sem o $ (ex.: admiravelcafe)
INFINITEPAY_HANDLE=
# opcional, só se a InfinitePay fornecer uma chave de API para a conta
INFINITEPAY_API_KEY=
# alternativa (PAGAMENTO_PROVEDOR=mercadopago)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---------- Nota fiscal (deixe NF_PROVEDOR vazio para vender com declaração de conteúdo) ----------
NF_PROVEDOR=
NOTAAS_API_KEY=
NOTAAS_WEBHOOK_SECRET=
# alternativa (NF_PROVEDOR=focus)
FOCUS_TOKEN=
FOCUS_AMBIENTE=homologacao
FOCUS_WEBHOOK_SECRET=

# ---------- Frete e etiqueta (Melhor Envio) ----------
ME_TOKEN=
# true = ambiente de teste (sandbox.melhorenvio.com.br). Troque para false quando for vender de verdade.
ME_SANDBOX=true
ME_EMAIL=admiravelcafe@gmail.com

# ---------- Avisos ----------
# e-mail (Resend): para quem vai o aviso de pedido novo, e de qual endereço saem os e-mails
RESEND_API_KEY=
AVISO_EMAIL_PARA=admiravelcafe@gmail.com
AVISO_EMAIL_DE=Admirável Café <pedidos@admiravelcafe.com.br>
# Telegram (opcional, aviso no celular na hora)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
